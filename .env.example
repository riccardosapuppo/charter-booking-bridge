# What the bridge reads, and the only place it reads it.
#
# Names, no values. An account written into a file under version control is an
# account in backups, in staging copies, in every diff, and in whatever editor
# the platform offers to whoever administers it — so the names are the part of
# it that belongs in a repository, and this file is all of that part.
#
# The manager takes the account inside the JSON body rather than in a header,
# and in two shapes depending on the endpoint. Both shapes are built in one
# place: see src/Secrets.php.
#
# Copy this to .env, or set these in the web server, or define them in
# wp-config.php and putenv() them there. .env is in .gitignore.

CHARTER_MANAGER_USERNAME=
CHARTER_MANAGER_PASSWORD=

# Where the manager is. Not in this repository: which supplier an operator
# books through is the operator's business, not this code's.
CHARTER_MANAGER_URL=

# The one operator this site sells for. A number, from the supplier.
#
# It is set here and not read from a request: whose catalogue this site fetches,
# with this site's account, is not a decision a visitor gets to make.
CHARTER_OPERATOR_ID=
